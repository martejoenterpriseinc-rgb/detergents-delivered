# =============================================================================
# Detergents Delivered — environment placeholders
# Copy to .env.local for development. NEVER commit real secrets.
# Development must NOT point at production databases or live payment accounts.
# =============================================================================

# development | staging | production
APP_ENV=development

# Public site URL (Auth.js also reads AUTH_URL)
NEXTAUTH_URL=http://localhost:3000
AUTH_URL=http://localhost:3000

# Required. Generate with: openssl rand -base64 32
AUTH_SECRET=

# PostgreSQL — local docker-compose default. Do not use production here.
DATABASE_URL=postgresql://dd_dev:dd_dev_password@localhost:5432/detergents_delivered_dev?schema=public
# Required outside development; must exactly match the reviewed DATABASE_URL target.
DD_DATABASE_HOST=
DD_DATABASE_NAME=

# Dev-only custom admin (ignored unless APP_ENV=development)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=

# Bootstrap SUPER_ADMIN (staging/dev). See docs/DEPLOYMENT.md “Bootstrap admin”.
# Explicit one-time setup, only if no administrator exists. Never resets an account.
SEED_BOOTSTRAP_ADMIN=false
# Required for opt-in setup: generate a unique 20–72-byte temporary password.
# First login forces a new email + password. Do not use this value in production.
SEED_BOOTSTRAP_ADMIN_PASSWORD=

# Set true to seed vendor + detergent variants + PO receive + publish to /shop
SEED_DEMO_CATALOG=false
# Non-production only. If the catalog is empty, seed household products on boot
# (and on the first /shop request). Staging can use this for the storefront mockup.
DEMO_MODE=false

# Local/dev object-storage stub (private files; not served from public/)
LOCAL_UPLOAD_DIR=./uploads

# Google OAuth (optional — credentials sign-in works without these)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Stripe (Phase 3+) — use test keys only in development/staging
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_TAX_ENABLED=false

# QuickBooks Online (Phase 7)
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REDIRECT_URI=
QBO_ENVIRONMENT=sandbox
QBO_COMPANY_ID=
QBO_WEBHOOK_VERIFIER_TOKEN=

# Maps / geocoding / routing (Phase 5)
MAPS_API_KEY=
MAPS_PROVIDER=google

# Transactional email (Phase 3+)
EMAIL_FROM=Detergents Delivered <hello@localhost>
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
# Password reset delivery currently uses EMAIL_PROVIDER=sendgrid, EMAIL_API_KEY,
# a verified EMAIL_FROM, and the trusted AUTH_URL above. Run auth:deliver every
# minute for durable retries. No SMTP fallback or logging of recovery links.
# Required outside production: comma-separated approved test recipients only.
DD_EMAIL_ALLOWED_RECIPIENTS=

# SMS / delivery notifications (Phase 5)
SMS_PROVIDER=
SMS_ACCOUNT_SID=
SMS_AUTH_TOKEN=
SMS_FROM_NUMBER=

# Object storage for private media (delivery photos, receipts)
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_PUBLIC_BASE_URL=
