// Detergents Delivered — core domain schema (Phase 1 foundation).
//
// Money: every currency amount is Int minor units (cents). NEVER Float/Decimal for money.
// Inventory: quantity changes are recorded ONLY via InventoryTransaction (ledger).
//            InventoryBalance is a derived projection, never silently overwritten.
// Financial history: payments, refunds, tax snapshots, and order line prices are
//            append-safe. Do not update historical money rows in place.
// Soft delete: operational entities may use deletedAt. Ledger / payment / tax
//            rows are not hard-deleted and are not rewritten.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identity & authorization
// ---------------------------------------------------------------------------

enum RoleCode {
  CUSTOMER
  ADMIN
  INVENTORY
  DRIVER
  CPA
  SUPER_ADMIN
}

model User {
  commerceGrants CommerceGrant[]
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  /// Null for OAuth-only accounts. Never log or expose this value.
  passwordHash  String?
  /// When true, the user must rotate login email and password before staff routes.
  mustChangeCredentials Boolean @default(false)
  sessionVersion Int @default(0)
  passwordChangeFailures Int @default(0)
  passwordChangeLockedUntil DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  accounts             Account[]
  sessions             Session[]
  userRoles            UserRole[]
  customer             Customer?
  auditLogs            AuditLog[]             @relation("AuditActor")
  inventoryTxns        InventoryTransaction[] @relation("InventoryTxnActor")
  mileageTrips         MileageTrip[]
  deliveryAttempts     DeliveryAttempt[]
  createdPurchaseOrders PurchaseOrder[]       @relation("PoCreatedBy")
  createdReceipts      Receipt[]              @relation("ReceiptCreatedBy")
  createdOrders        Order[]                @relation("OrderCreatedBy")
  assignedRouteStops   RouteStop[]            @relation("StopDriver")
  updatedSiteSections  SiteSection[]          @relation("SiteSectionUpdatedBy")
  supportMessages SupportMessage[]
  deliveryActions DeliveryAction[]
  customerInvites CustomerInvite[]
  passwordRecoveries PasswordRecovery[]
  refundRequests     RefundRequest[]       @relation("RefundRequestActor")
  stockReturns       StockReturn[]         @relation("StockReturnActor")

  @@index([deletedAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Short-lived security records. Reset tokens are hashed for lookup and encrypted
// only while awaiting email delivery. Never include these fields in API output.
model PasswordRecovery {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  email String
  sessionVersion Int
  tokenHash String @unique
  tokenCiphertext Bytes?
  expiresAt DateTime
  consumedAt DateTime?
  deliveredAt DateTime?
  attempts Int @default(0)
  nextAttemptAt DateTime @default(now())
  leaseId String?
  leasedUntil DateTime?
  createdAt DateTime @default(now())

  @@index([userId, consumedAt])
  @@index([nextAttemptAt, deliveredAt])
  @@index([expiresAt])
}

model AuthenticationThrottle {
  key String @id
  hits Int
  expiresAt DateTime

  @@index([expiresAt])
}

model Role {
  id          String   @id @default(cuid())
  code        RoleCode @unique
  name        String
  description String?

  userRoles   UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String  @id @default(cuid())
  code        String  @unique
  name        String
  description String?

  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRole {
  userId     String
  roleId     String
  assignedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

// ---------------------------------------------------------------------------
// Customers & addresses
// ---------------------------------------------------------------------------

model Customer {
  smsConsents SmsConsent[]
  commerceGrants CommerceGrant[]
  purchaseApprovedAt DateTime?
  id        String    @id @default(cuid())
  userId    String    @unique
  user      User      @relation(fields: [userId], references: [id])
  firstName String?
  lastName  String?
  phone     String?
  emailNotifications Boolean @default(false)
  smsNotifications Boolean @default(false)
  notes     String?   @db.Text
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  addresses     Address[]
  orders        Order[]
  subscriptions Subscription[]
  referralsMade Referral[]     @relation("Referrer")
  referredBy    Referral?      @relation("Referee")
  supportTickets SupportTicket[]
  referralLinks ReferralLink[]
  rewardEntries RewardEntry[]
  rewardReservations RewardReservation[]
  checkoutAttempts CheckoutAttempt[]

  @@index([phone])
  @@index([deletedAt])
}

model Address {
  validatedAt DateTime?
  validationSource String?
  id           String    @id @default(cuid())
  customerId   String
  customer     Customer  @relation(fields: [customerId], references: [id])
  label        String?
  line1        String
  line2        String?
  city         String
  region       String
  postalCode   String
  country      String    @default("US")
  lat          Float?
  lng          Float?
  deliveryZoneId String?
  deliveryZone DeliveryZone? @relation(fields: [deliveryZoneId], references: [id])
  isDefault    Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  orders          Order[]
  subscriptions   Subscription[]
  routeStops      RouteStop[]
  deliveryAttempts DeliveryAttempt[]

  @@index([customerId])
  @@index([postalCode])
  @@index([deliveryZoneId])
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

enum ProductForm {
  LIQUID
  POWDER
  PODS
  SHEETS
  OTHER
}

enum PriceKind {
  RETAIL
  SUBSCRIPTION
  SALE
}

model Category {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String?
  parentId    String?
  parent      Category? @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryTree")
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  products Product[]

  @@index([parentId])
  @@index([isActive])
}

model Product {
  loadKind String @default("OTHER")
  id                    String      @id @default(cuid())
  slug                  String      @unique
  name                  String
  brand                 String
  description           String?     @db.Text
  categoryId            String?
  category              Category?   @relation(fields: [categoryId], references: [id])
  form                  ProductForm @default(OTHER)
  taxCategory           String?
  /// Units this product consumes against a route's daily capacity.
  deliveryCapacityUnits Int         @default(1)
  /// When false, storefront only lists variants with available > 0.
  allowPreorder         Boolean     @default(false)
  isActive              Boolean     @default(true)
  websiteVisible        Boolean     @default(false)
  featured              Boolean     @default(false)
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  deletedAt             DateTime?

  variants ProductVariant[]
  images   ProductImage[]

  @@index([brand])
  @@index([categoryId])
  @@index([isActive, websiteVisible])
}

/// Sellable SKU. Do not duplicate the parent Product for each size/scent.
model ProductVariant {
  id                    String    @id @default(cuid())
  productId             String
  product               Product   @relation(fields: [productId], references: [id])
  sku                   String    @unique
  upc                   String?   @unique
  name                  String
  scent                 String?
  sizeLabel             String?
  sizeValue             Decimal?  @db.Decimal(12, 3)
  sizeUnit              String?
  weightValue           Decimal?  @db.Decimal(12, 3)
  weightUnit            String?
  lengthIn              Decimal?  @db.Decimal(12, 3)
  widthIn               Decimal?  @db.Decimal(12, 3)
  heightIn              Decimal?  @db.Decimal(12, 3)
  uom                   String?
  casePack              Int?
  taxCategory           String?
  reorderPoint          Int?
  reorderQty            Int?
  deliveryCapacityUnits Int?
  isActive              Boolean   @default(true)
  websiteVisible        Boolean   @default(true)
  featured              Boolean   @default(false)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  deletedAt             DateTime?

  prices            ProductPrice[]
  images            ProductImage[]
  vendorProducts    VendorProduct[]
  poItems           PurchaseOrderItem[]
  receiptItems      ReceiptItem[]
  inventoryTxns     InventoryTransaction[]
  inventoryBalance  InventoryBalance?
  costLayers        InventoryCostLayer[]
  orderItems        OrderItem[]
  subscriptionItems SubscriptionItem[]

  @@index([productId])
  @@index([isActive])
  @@index([sku])
}

/// Time-bounded list price. Insert a new row to change price; do not rewrite amount history.
model ProductPrice {
  id               String         @id @default(cuid())
  productVariantId String
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id])
  kind             PriceKind      @default(RETAIL)
  /// List price in cents.
  amountCents      Int
  currency         String         @default("USD")
  startsAt         DateTime
  endsAt           DateTime?
  createdAt        DateTime       @default(now())

  @@index([productVariantId, kind, startsAt])
}

model ProductImage {
  id               String          @id @default(cuid())
  productId        String?
  product          Product?        @relation(fields: [productId], references: [id])
  productVariantId String?
  productVariant   ProductVariant? @relation(fields: [productVariantId], references: [id])
  storageKey       String
  alt              String?
  sortOrder        Int             @default(0)
  isPrimary        Boolean         @default(false)
  createdAt        DateTime        @default(now())

  @@index([productId])
  @@index([productVariantId])
}

// ---------------------------------------------------------------------------
// Vendors, purchasing, receiving
// ---------------------------------------------------------------------------

enum PurchaseOrderStatus {
  DRAFT
  SUBMITTED
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

model Vendor {
  id            String    @id @default(cuid())
  name          String
  contactName   String?
  email         String?
  phone         String?
  addressLine1  String?
  addressLine2  String?
  city          String?
  region        String?
  postalCode    String?
  country       String    @default("US")
  paymentTerms  String?
  notes         String?   @db.Text
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  products       VendorProduct[]
  purchaseOrders PurchaseOrder[]

  @@index([isActive])
  @@index([name])
}

model VendorProduct {
  id               String         @id @default(cuid())
  vendorId         String
  vendor           Vendor         @relation(fields: [vendorId], references: [id])
  productVariantId String
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id])
  vendorSku        String?
  /// Last known unit cost in cents. Historical costs live on PO / receipt lines.
  unitCostCents    Int?
  currency         String         @default("USD")
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([vendorId, productVariantId])
}

model PurchaseOrder {
  id              String               @id @default(cuid())
  number          String               @unique
  vendorId        String
  vendor          Vendor               @relation(fields: [vendorId], references: [id])
  status          PurchaseOrderStatus  @default(DRAFT)
  orderedAt       DateTime?
  expectedAt      DateTime?
  /// Expected merchandise total in cents (snapshot).
  subtotalCents   Int                  @default(0)
  freightCents    Int                  @default(0)
  feeCents        Int                  @default(0)
  taxCents        Int                  @default(0)
  otherCostCents  Int                  @default(0)
  /// Landed cost estimate = merchandise + freight + fees + tax + other (cents).
  landedCostCents Int                  @default(0)
  currency        String               @default("USD")
  notes           String?              @db.Text
  createdByUserId String?
  createdBy       User?                @relation("PoCreatedBy", fields: [createdByUserId], references: [id])
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  items    PurchaseOrderItem[]
  receipts Receipt[]

  @@index([vendorId])
  @@index([status])
}

model PurchaseOrderItem {
  id               String         @id @default(cuid())
  purchaseOrderId  String
  purchaseOrder    PurchaseOrder  @relation(fields: [purchaseOrderId], references: [id])
  productVariantId String
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id])
  quantityOrdered  Int
  quantityReceived Int            @default(0)
  unitCostCents    Int
  discountCents    Int            @default(0)
  freightCents     Int            @default(0)
  feeCents         Int            @default(0)
  taxCents         Int            @default(0)
  otherCostCents   Int            @default(0)
  lineTotalCents   Int

  receiptItems ReceiptItem[]

  @@index([purchaseOrderId])
  @@index([productVariantId])
}

model Receipt {
  id              String         @id @default(cuid())
  number          String         @unique
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  receivedAt      DateTime       @default(now())
  notes           String?        @db.Text
  createdByUserId String?
  createdBy       User?          @relation("ReceiptCreatedBy", fields: [createdByUserId], references: [id])
  createdAt       DateTime       @default(now())

  items ReceiptItem[]

  @@index([purchaseOrderId])
  @@index([number])
}

model ReceiptItem {
  id                    String             @id @default(cuid())
  receiptId             String
  receipt               Receipt            @relation(fields: [receiptId], references: [id])
  purchaseOrderItemId   String?
  purchaseOrderItem     PurchaseOrderItem? @relation(fields: [purchaseOrderItemId], references: [id])
  productVariantId      String
  productVariant        ProductVariant     @relation(fields: [productVariantId], references: [id])
  quantityReceived      Int
  quantityDamaged       Int                @default(0)
  quantityShortage      Int                @default(0)
  quantityOverage       Int                @default(0)
  unitCostCents         Int
  /// Allocated landed unit cost for sellable units in cents.
  landedUnitCostCents   Int?
  costDiscrepancyNotes  String?            @db.Text

  costLayers InventoryCostLayer[]

  @@index([receiptId])
  @@index([productVariantId])
}

// ---------------------------------------------------------------------------
// Inventory ledger
// ---------------------------------------------------------------------------

enum InventoryTxnType {
  RECEIPT
  PURCHASE_RECEIPT
  SALE
  RESERVE
  CUSTOMER_RESERVATION
  RELEASE
  RESERVATION_RELEASE
  ROUTE_ALLOCATION
  ROUTE_LOAD
  DELIVERY
  ADJUSTMENT
  RETURN
  DAMAGE
  LOSS
  COUNT
  TRANSFER
  TRANSFER_IN
  TRANSFER_OUT
}

/// Append-only ledger. Application code must never UPDATE or DELETE these rows.
model InventoryTransaction {
  id               String           @id @default(cuid())
  productVariantId String
  productVariant   ProductVariant   @relation(fields: [productVariantId], references: [id])
  type             InventoryTxnType
  /// Signed quantity in sellable units. Positive increases on-hand (or reserve).
  quantity         Int
  resultingOnHand  Int
  resultingReserved Int
  referenceType    String?
  referenceId      String?
  reason           String?
  createdByUserId  String?
  createdBy        User?            @relation("InventoryTxnActor", fields: [createdByUserId], references: [id])
  createdAt        DateTime         @default(now())

  @@index([productVariantId, createdAt])
  @@index([referenceType, referenceId])
}

/// Derived projection of the ledger. Update ONLY as the result of applying a transaction.
model InventoryBalance {
  id               String         @id @default(cuid())
  productVariantId String         @unique
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id])
  onHandQty        Int            @default(0)
  reservedQty      Int            @default(0)
  damagedQty       Int            @default(0)
  inTransitQty     Int            @default(0)
  updatedAt        DateTime       @updatedAt
}

/// FIFO / receipt cost layer. Consume remaining qty at sale time (Phase 3); never rewrite historical unit cost.
model InventoryCostLayer {
  id                  String          @id @default(cuid())
  productVariantId    String
  productVariant      ProductVariant  @relation(fields: [productVariantId], references: [id])
  receiptItemId       String?
  receiptItem         ReceiptItem?    @relation(fields: [receiptItemId], references: [id])
  checkoutAllocations CheckoutCostAllocation[]
  quantityOriginal    Int
  quantityRemaining   Int
  landedUnitCostCents Int
  receivedAt          DateTime
  createdAt           DateTime        @default(now())

  @@index([productVariantId, receivedAt])
  @@index([receiptItemId])
}

/// Attachment metadata only. Bytes live in object storage (or the local/dev stub). Never store public unsigned URLs.
model Attachment {
  id          String   @id @default(cuid())
  entityType  String
  entityId    String
  storageKey  String
  filename    String
  contentType String?
  byteSize    Int?
  notes       String?
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
}

// ---------------------------------------------------------------------------
// Orders, payments, tax, subscriptions
// ---------------------------------------------------------------------------

enum OrderStatus {
  DRAFT
  PENDING_PAYMENT
  PAID
  FULFILLING
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentProvider {
  STRIPE
  MANUAL
}

model Order {
  costExports QboCostExport[]
  smsDeliveries SmsDelivery[]
  id              String      @id @default(cuid())
  number          String      @unique
  customerId      String
  customer        Customer    @relation(fields: [customerId], references: [id])
  addressId       String?
  address         Address?    @relation(fields: [addressId], references: [id])
  status          OrderStatus @default(DRAFT)
  currency        String      @default("USD")
  subtotalCents   Int         @default(0)
  discountCents   Int         @default(0)
  shippingCents   Int         @default(0)
  taxCents        Int         @default(0)
  totalCents      Int         @default(0)
  notes           String?     @db.Text
  placedAt        DateTime?
  createdByUserId String?
  createdBy       User?       @relation("OrderCreatedBy", fields: [createdByUserId], references: [id])
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  items            OrderItem[]
  payments         Payment[]
  refunds          Refund[]
  taxCalculation   TaxCalculation?
  routeStops       RouteStop[]
  deliveryAttempts DeliveryAttempt[]
  subscription     Subscription?     @relation("SubscriptionOrigin")
  supportTickets SupportTicket[]
  rewardReservation RewardReservation?
  rewardEntries RewardEntry[]
  qualifyingReferral Referral? @relation("ReferralQualifyingOrder")
  checkoutAttempt CheckoutAttempt?
  refundRequests RefundRequest[]
  stockReturns StockReturn[]

  @@index([customerId])
  @@index([status])
  @@index([placedAt])
}

/// Line snapshots. unitPriceCents is frozen at checkout — do not rewrite after capture.
model OrderItem {
  id               String         @id @default(cuid())
  orderId          String
  order            Order          @relation(fields: [orderId], references: [id])
  productVariantId String
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id])
  nameSnapshot     String
  skuSnapshot      String
  quantity         Int
  unitPriceCents   Int
  /// Landed/COGS snapshot at sale time (Phase 3). Null until checkout consumes a cost layer.
  landedUnitCostCents Int?
  discountCents    Int            @default(0)
  taxCents         Int            @default(0)
  lineTotalCents   Int
  refundLines      RefundRequestLine[]
  stockReturnLines StockReturnLine[]

  @@index([orderId])
  @@index([productVariantId])
}

model Payment {
  id              String          @id @default(cuid())
  orderId         String
  order           Order           @relation(fields: [orderId], references: [id])
  provider        PaymentProvider @default(STRIPE)
  status          PaymentStatus   @default(PENDING)
  amountCents     Int
  currency        String          @default("USD")
  externalId      String?         @unique
  idempotencyKey  String?         @unique
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  events  PaymentEvent[]
  refunds Refund[]
  refundRequests RefundRequest[]

  @@index([orderId])
  @@index([status])
}

/// Append-only payment webhook / state events. Never rewrite; insert new events.
model PaymentEvent {
  id         String   @id @default(cuid())
  paymentId  String
  payment    Payment  @relation(fields: [paymentId], references: [id])
  type       String
  payload    Json?
  externalId String?  @unique
  createdAt  DateTime @default(now())
  /// Set only by the future verified provider webhook adapter. Legacy events remain unverified.
  verifiedAt DateTime?

  @@index([paymentId, createdAt])
}

model Refund {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id])
  paymentId   String?
  payment     Payment? @relation(fields: [paymentId], references: [id])
  amountCents Int
  currency    String   @default("USD")
  reason      String?
  externalId  String?  @unique
  requestId   String?  @unique
  request     RefundRequest? @relation(fields: [requestId], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())

  @@index([orderId])
}

enum RefundRequestStatus {
  PREPARED
  SUBMITTING
  UNKNOWN
  PENDING
  REQUIRES_ACTION
  SUCCEEDED
  FAILED
  CANCELED
}

/// Durable provider operation. UNKNOWN remains reserved until reconciliation proves an outcome.
model RefundRequest {
  id                String              @id @default(cuid())
  orderId           String
  order             Order               @relation(fields: [orderId], references: [id], onDelete: Restrict)
  paymentId         String
  payment           Payment             @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  actorUserId       String
  actor             User                @relation("RefundRequestActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  requestKey        String              @unique
  requestHash       String
  amountCents       Int
  currency          String
  reason            String
  providerAccountId String
  livemode          Boolean
  providerRefundId  String?             @unique
  status            RefundRequestStatus @default(PREPARED)
  lastError         String?
  submittedAt       DateTime?
  recoveryCheckedAt DateTime?
  reconciledAt      DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  lines  RefundRequestLine[]
  events RefundRequestEvent[]
  refund Refund?
  adjustments RefundAdjustment[]

  @@index([orderId, createdAt])
  @@index([paymentId, status])
  @@index([status, updatedAt])
  @@index([livemode, providerAccountId, recoveryCheckedAt])
}

model RefundRequestLine {
  id              String        @id @default(cuid())
  refundRequestId String
  refundRequest   RefundRequest @relation(fields: [refundRequestId], references: [id], onDelete: Restrict)
  orderItemId     String
  orderItem       OrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  quantity        Int
  netCents        Int
  taxCents        Int
  rewardCents     Int

  @@unique([refundRequestId, orderItemId])
  @@index([orderItemId])
}

/// Append-only minimal provider evidence; never store raw customer or payment-method payloads.
model RefundRequestEvent {
  id              String        @id @default(cuid())
  refundRequestId String
  refundRequest   RefundRequest @relation(fields: [refundRequestId], references: [id], onDelete: Restrict)
  providerEventId String?       @unique
  type            String
  status          RefundRequestStatus
  evidenceJson    Json?
  verifiedAt      DateTime?
  createdAt       DateTime      @default(now())

  @@index([refundRequestId, createdAt])
}

enum StockReturnCondition {
  SELLABLE
  DAMAGED
}

/// Receiving merchandise is explicit and independent from returning payment funds.
model StockReturn {
  costExports QboCostExport[]
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  actorUserId String
  actor       User     @relation("StockReturnActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  requestKey  String   @unique
  requestHash String
  reason      String
  receivedAt  DateTime
  createdAt   DateTime @default(now())

  lines StockReturnLine[]

  @@index([orderId, createdAt])
}

model StockReturnLine {
  id            String               @id @default(cuid())
  stockReturnId String
  stockReturn   StockReturn          @relation(fields: [stockReturnId], references: [id], onDelete: Restrict)
  orderItemId   String
  orderItem     OrderItem             @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  quantity      Int
  condition     StockReturnCondition
  /// Original consumed allocation IDs, quantities and unit costs for received goods.
  costEvidence  Json

  @@unique([stockReturnId, orderItemId])
  @@index([orderItemId])
}

/// Destination-based tax snapshot at calculation time. Historical rows stay immutable.
model TaxCalculation {
  id              String   @id @default(cuid())
  orderId         String   @unique
  order           Order    @relation(fields: [orderId], references: [id])
  provider        String
  destinationJson Json
  taxableCents    Int
  taxCents        Int
  currency        String   @default("USD")
  breakdownJson   Json?
  externalId      String?
  createdAt       DateTime @default(now())
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
  PAST_DUE
}

model Subscription {
  id                String             @id @default(cuid())
  customerId        String
  customer          Customer           @relation(fields: [customerId], references: [id])
  addressId         String?
  address           Address?           @relation(fields: [addressId], references: [id])
  status            SubscriptionStatus @default(ACTIVE)
  cadenceDays       Int?
  cadenceMonths     Int?
  anchorDate        DateTime?          @db.Date
  cycleNumber       Int                @default(1)
  version           Int                @default(0)
  consentVersion    String?
  consentedAt       DateTime?
  events            SubscriptionEvent[]
  nextOrderAt       DateTime?
  originOrderId     String?            @unique
  originOrder       Order?             @relation("SubscriptionOrigin", fields: [originOrderId], references: [id])
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  cancelledAt       DateTime?

  items SubscriptionItem[]
  cycles SubscriptionCycle[]

  @@index([customerId])
  @@index([status, nextOrderAt])
}

model SubscriptionItem {
  id               String         @id @default(cuid())
  subscriptionId   String
  subscription     Subscription   @relation(fields: [subscriptionId], references: [id])
  productVariantId String
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id])
  quantity         Int

  @@index([subscriptionId])
}

// ---------------------------------------------------------------------------
// Delivery, routing, mileage
// ---------------------------------------------------------------------------

model DeliveryZone {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  /// GeoJSON polygon or postal-code list. Validated in application layer.
  boundaryJson   Json?
  capacityPerDay Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  addresses Address[]
  routes    Route[]
}

enum RouteStatus {
  DRAFT
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Vehicle {
  capacityUnits Int @default(0)
  detergentBucketLimit Int @default(0)
  scentBeadBucketLimit Int @default(0)
  id           String    @id @default(cuid())
  name         String
  plate        String?   @unique
  capacityStops Int      @default(20)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  routes       Route[]
  mileageTrips MileageTrip[]
}

model Route {
  id             String      @id @default(cuid())
  number         String      @unique
  serviceDate    DateTime    @db.Date
  status         RouteStatus @default(DRAFT)
  vehicleId      String?
  vehicle        Vehicle?    @relation(fields: [vehicleId], references: [id])
  deliveryZoneId String?
  deliveryZone   DeliveryZone? @relation(fields: [deliveryZoneId], references: [id])
  plannedMiles   Decimal?    @db.Decimal(10, 2)
  actualMiles    Decimal?    @db.Decimal(10, 2)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  deliveryActions DeliveryAction[]
  legs RouteLeg[]
  stops        RouteStop[]
  mileageTrips MileageTrip[]

  @@index([serviceDate, status])
  @@index([vehicleId])
}

model RouteStop {
  id              String   @id @default(cuid())
  routeId         String
  route           Route    @relation(fields: [routeId], references: [id])
  orderId         String?
  order           Order?   @relation(fields: [orderId], references: [id])
  addressId       String
  address         Address  @relation(fields: [addressId], references: [id])
  sequence        Int
  driverUserId    String?
  driver          User?    @relation("StopDriver", fields: [driverUserId], references: [id])
  plannedArriveAt DateTime?
  startedAt       DateTime?
  arrivedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime @default(now())

  deliveryAttempts DeliveryAttempt[]
  actions DeliveryAction[]
  legsFrom RouteLeg[] @relation("LegFrom")
  legsTo RouteLeg[] @relation("LegTo")

  @@unique([routeId, sequence])
  @@index([orderId])
  @@index([driverUserId])
}

enum DeliveryAttemptResult {
  DELIVERED
  FAILED
  REFUSED
  RESCHEDULED
}

model DeliveryAttempt {
  id          String                 @id @default(cuid())
  orderId     String
  order       Order                  @relation(fields: [orderId], references: [id])
  routeStopId String?
  routeStop   RouteStop?             @relation(fields: [routeStopId], references: [id])
  addressId   String
  address     Address                @relation(fields: [addressId], references: [id])
  driverUserId String
  driver      User                   @relation(fields: [driverUserId], references: [id])
  result      DeliveryAttemptResult
  notes       String?
  attemptedAt DateTime               @default(now())

  photos DeliveryPhoto[]

  @@index([orderId])
  @@index([driverUserId])
}

model DeliveryPhoto {
  id                String          @id @default(cuid())
  deliveryAttemptId String
  deliveryAttempt   DeliveryAttempt @relation(fields: [deliveryAttemptId], references: [id])
  storageKey        String
  capturedAt        DateTime        @default(now())

  @@index([deliveryAttemptId])
}

/// Durable image bytes are deliberately separate from public product/order DTOs.
/// Private proof photos are encrypted; reads require the existing proof authorization.
model OperationalMedia {
  key         String   @id
  kind        String
  environment String
  bytes       Bytes
  keyId       String?
  sha256      String
  byteSize    Int
  createdAt   DateTime @default(now())

  @@index([environment, kind, createdAt])
}

/// Short claims coordinate scheduler instances; provider work runs outside transactions.
model OperationalJob {
  id              String   @id
  environment     String
  state           String   @default("WAITING")
  leaseId         String?
  leasedUntil     DateTime?
  nextRunAt       DateTime @default(now())
  startedAt       DateTime?
  finishedAt      DateTime?
  heartbeatAt     DateTime?
  lastSuccessAt   DateTime?
  consecutiveFailures Int @default(0)
  checked         Int @default(0)
  completed       Int @default(0)
  attention       Int @default(0)
  reason          String?
  updatedAt       DateTime @updatedAt

  @@index([environment, nextRunAt])
}

model MileageTrip {
  id          String   @id @default(cuid())
  vehicleId   String
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id])
  routeId     String?
  route       Route?   @relation(fields: [routeId], references: [id])
  driverUserId String
  driver      User     @relation(fields: [driverUserId], references: [id])
  startedAt   DateTime
  endedAt     DateTime?
  startOdometer Int?
  endOdometer   Int?
  miles       Decimal? @db.Decimal(10, 2)
  purpose     String?
  createdAt   DateTime @default(now())

  @@index([vehicleId, startedAt])
  @@index([driverUserId])
}

// ---------------------------------------------------------------------------
// Promotions, referrals, expenses
// ---------------------------------------------------------------------------

model Promotion {
  minimumPurchaseCents Int @default(0)
  maximumDiscountCents Int?
  audience String @default("ALL")
  allowRewards Boolean @default(false)
  version Int @default(0)
  startsOn String?
  endsOn String?
  id              String    @id @default(cuid())
  code            String    @unique
  name            String
  /// Discount amount in cents when type is FIXED; basis points when PERCENT (1000 = 10%).
  value           Int
  valueType       String
  startsAt        DateTime
  endsAt          DateTime?
  maxRedemptions  Int?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Referral {
  id            String    @id @default(cuid())
  referrerId    String
  referrer      Customer  @relation("Referrer", fields: [referrerId], references: [id])
  refereeId     String    @unique
  referee       Customer  @relation("Referee", fields: [refereeId], references: [id])
  code          String
  creditCents   Int       @default(0)
  redeemedAt    DateTime?
  createdAt     DateTime  @default(now())
  linkId        String? @unique
  link          ReferralLink? @relation(fields: [linkId], references: [id])
  status        ReferralState @default(PENDING)
  friendCreditCents Int @default(0)
  minimumPurchaseCents Int @default(0)
  programVersion Int @default(0)
  qualifyingOrderId String? @unique
  qualifyingOrder Order? @relation("ReferralQualifyingOrder", fields: [qualifyingOrderId], references: [id])
  reversedAt DateTime?

  @@index([referrerId])
  @@index([code])
}

enum ReferralState {
  PENDING
  REWARDED
  REVERSED
}

model LoyaltyProgram {
  id String @id @default("default")
  enabled Boolean @default(false)
  referrerRewardCents Int @default(0)
  friendRewardCents Int @default(0)
  minimumPurchaseCents Int @default(0)
  linkExpiryDays Int @default(30)
  maxReferralsPerCustomer Int @default(25)
  version Int @default(0)
  updatedAt DateTime @updatedAt
}

model ReferralLink {
  id String @id @default(cuid())
  customerId String
  customer Customer @relation(fields: [customerId], references: [id])
  token String @unique
  label String
  requestKey String
  createdAt DateTime @default(now())
  expiresAt DateTime
  copiedAt DateTime?
  sharedAt DateTime?
  openedAt DateTime?
  referral Referral?
  @@unique([customerId, requestKey])
  @@index([customerId, createdAt])
}

enum RewardEntryKind {
  REFERRAL
  REDEMPTION
  RESTORE
  REVERSAL
}

/// Append-only dollar-credit ledger. Negative balances after reversal block future spending.
model RewardEntry {
  id String @id @default(cuid())
  customerId String
  customer Customer @relation(fields: [customerId], references: [id])
  entryKey String @unique
  kind RewardEntryKind
  amountCents Int
  orderId String?
  order Order? @relation(fields: [orderId], references: [id])
  sourceId String
  description String
  createdAt DateTime @default(now())
  @@index([customerId, createdAt])
  @@index([sourceId])
}

enum RewardReservationState {
  HELD
  USED
  RELEASED
}

/// Reserved credits are held until a trusted checkout finalizer confirms success or cancellation.
model RewardReservation {
  id String @id @default(cuid())
  orderId String @unique
  order Order @relation(fields: [orderId], references: [id])
  customerId String
  customer Customer @relation(fields: [customerId], references: [id])
  amountCents Int
  orderTotalCents Int
  requestKey String
  state RewardReservationState @default(HELD)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([customerId, requestKey])
  @@index([customerId, state])
}

model ExpenseCategory {
  id        String    @id @default(cuid())
  name      String    @unique
  qboAccountId String?
  createdAt DateTime  @default(now())

  expenses Expense[]
}

model Expense {
  quickbooksExports QboExpenseExport[]
  id                String          @id @default(cuid())
  categoryId        String
  category          ExpenseCategory @relation(fields: [categoryId], references: [id])
  amountCents       Int
  currency          String          @default("USD")
  incurredOn        DateTime        @db.Date
  memo              String?
  receiptStorageKey String?
  qboTxnId          String?         @unique
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([categoryId, incurredOn])
}

model QboExpenseExport {
  @@index([mode, realm, status, recoveryCheckedAt], map: "QboExpenseExport_recovery_idx")
  recoveryCheckedAt DateTime?
  reconciliationIssue String?
  id String @id
  expenseId String
  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Restrict)
  mode String
  realm String
  status String @default("DRAFT")
  docNumber String
  requestHash String
  source Json
  mapping Json
  payload Json
  externalId String?
  submittedAt DateTime?
  confirmedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([mode, realm, docNumber])
  @@unique([mode, realm, externalId])
  @@index([expenseId, status])
}

// ---------------------------------------------------------------------------
// Platform
// ---------------------------------------------------------------------------

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  actor       User?    @relation("AuditActor", fields: [actorUserId], references: [id])
  action      String
  entityType  String
  entityId    String
  beforeJson  Json?
  afterJson   Json?
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorUserId, createdAt])
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  valueJson Json
  updatedAt DateTime @updatedAt
}

// DetergentsDelivered business setup. Isolated from commerce and legal provider identity.
model BusinessSetup {
  id        String   @id
  version   Int      @default(0)
  dataJson  Json
  updatedAt DateTime @updatedAt
}

model BusinessSetupRevision {
  id        String   @id @default(cuid())
  version   Int      @unique
  actorId   String
  action    String
  dataJson  Json
  createdAt DateTime @default(now())
}

model BusinessAccess {
  userId    String   @id
  grantedBy String
  createdAt DateTime @default(now())
}

model BusinessDocument {
  id          String   @id @default(cuid())
  planId      String?
  stepKey     String?
  category    String
  title       String
  notes       String   @default("")
  issueDate   String?
  expiryDate  String?
  version     Int      @default(1)
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  versions    BusinessDocumentVersion[]
}

model BusinessDocumentVersion {
  id          String   @id @default(cuid())
  documentId  String
  document    BusinessDocument @relation(fields: [documentId], references: [id], onDelete: Restrict)
  number      Int
  requestKey  String   @unique
  requestHash String
  metadataJson Json
  uploadedBy  String
  contentType String
  size        Int
  sha256      String
  keyId       String
  ciphertext  Bytes?
  scanStatus  String   @default("QUARANTINED")
  scannedAt   DateTime?
  createdAt   DateTime @default(now())
  deletedAt   DateTime?
  @@unique([documentId, number])
  @@index([scanStatus, createdAt])
}

// ---------------------------------------------------------------------------
// Website builder: versioned content, drafts and durable marketing images
// ---------------------------------------------------------------------------

model SitePage {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sections SiteSection[]
  version Int @default(0)
  settingsJson Json?
  draftJson Json?
  revisions SiteRevision[]
}

model SiteRevision {
  id String @id @default(cuid())
  pageId String
  page SitePage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  requestKey String @unique
  requestHash String
  version Int
  mode String
  contentJson Json
  actorUserId String?
  createdAt DateTime @default(now())
  @@unique([pageId, version])
}

// Only validated, re-encoded marketing images. Never store private documents here.
model SiteMedia {
  id String @id @default(cuid())
  bytes Bytes
  sha256 String @unique
  mimeType String
  size Int
  width Int
  height Int
  uploadedByUserId String
  createdAt DateTime @default(now())
}

model PostalLocation {
  postalCode String @id
  latitude Float?
  longitude Float?
  placeName String?
  retryAt DateTime
  updatedAt DateTime @updatedAt
}

model SiteSection {
  id                String   @id @default(cuid())
  pageId            String
  page              SitePage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  /// Stable key within the page (e.g. "hero"). Unique per page.
  sectionId         String
  type              String
  title             String?
  body              String?  @db.Text
  badgeText         String?
  ctaLabel          String?
  ctaHref           String?
  secondaryCtaLabel String?
  secondaryCtaHref  String?
  visible           Boolean  @default(true)
  sortOrder         Int      @default(0)
  styleVariant      String?
  presentationJson Json?
  /// Admin notes: what this section should do (not shown on the storefront).
  intentNotes       String?  @db.Text
  updatedByUserId   String?
  updatedBy         User?    @relation("SiteSectionUpdatedBy", fields: [updatedByUserId], references: [id])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([pageId, sectionId])
  @@index([pageId, sortOrder])
  @@index([updatedByUserId])
}

// Customer support is independent of order/payment state. Resolving a ticket never refunds an order.
enum SupportStatus {
  OPEN
  IN_PROGRESS
  WAITING_CUSTOMER
  RESOLVED
}

model SupportTicket {
  id String @id @default(cuid())
  customerId String
  customer Customer @relation(fields: [customerId], references: [id])
  orderId String?
  order Order? @relation(fields: [orderId], references: [id])
  subject String
  category String
  status SupportStatus @default(OPEN)
  requestKey String
  requestHash String
  version Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  resolvedAt DateTime?
  messages SupportMessage[]

  @@unique([customerId, requestKey])
  @@index([customerId, updatedAt])
  @@index([status, updatedAt])
  @@index([orderId])
}

model SupportMessage {
  id String @id @default(cuid())
  ticketId String
  ticket SupportTicket @relation(fields: [ticketId], references: [id])
  authorUserId String
  author User @relation(fields: [authorUserId], references: [id])
  isStaff Boolean
  body String @db.Text
  requestKey String
  requestHash String
  createdAt DateTime @default(now())

  @@unique([ticketId, authorUserId, requestKey])
  @@index([ticketId, createdAt])
}


/// Request receipts prevent replayed driver transitions from creating duplicate events.
model DeliveryAction {
  actor User @relation(fields:[actorUserId],references:[id],onDelete:Restrict)
  route Route @relation(fields:[routeId],references:[id],onDelete:Restrict)
  stop RouteStop? @relation(fields:[stopId],references:[id],onDelete:Restrict)
  id String @id @default(cuid())
  requestKey String @unique
  actorUserId String
  routeId String
  stopId String?
  action String
  requestHash String
  createdAt DateTime @default(now())
}

/// Each saved route leg keeps planned and actual mileage separate.
model RouteLeg {
  route Route @relation(fields:[routeId],references:[id],onDelete:Restrict)
  fromStop RouteStop? @relation("LegFrom",fields:[fromStopId],references:[id],onDelete:Restrict)
  toStop RouteStop? @relation("LegTo",fields:[toStopId],references:[id],onDelete:Restrict)
  id String @id @default(cuid())
  routeId String
  sequence Int
  fromStopId String?
  toStopId String?
  plannedMiles Decimal? @db.Decimal(10,2)
  actualMiles Decimal? @db.Decimal(10,2)
  source String
  createdAt DateTime @default(now())
  @@unique([routeId, sequence])
}

/// A secure signup invitation is not account approval or email verification.
model CustomerInvite {
  createdBy User @relation(fields:[createdByUserId],references:[id],onDelete:Restrict)
  id String @id @default(cuid())
  email String
  firstName String
  token String @unique
  requestKey String @unique
  requestHash String
  createdByUserId String
  status String @default("CREATED")
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([email])
}

/// Durable checkout state. Provider uncertainty never releases resource holds.
model CheckoutAttempt {
  id String @id @default(cuid())
  paidSubscriptionCycle SubscriptionCycle? @relation("CyclePayment")
  subscriptionCycleId String?
  subscriptionCycle SubscriptionCycle? @relation("CycleAttempts", fields: [subscriptionCycleId], references: [id], onDelete: Restrict)
  customerId String
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  requestKey String
  requestHash String
  state String @default("QUOTED")
  snapshot Json
  expiresAt DateTime
  sessionExpiresAt DateTime?
  deliveryConfirmedAt DateTime?
  stripeSessionId String? @unique
  stripeCustomerId String?
  stripeAccountId String
  livemode Boolean
  orderId String? @unique
  order Order? @relation(fields: [orderId], references: [id], onDelete: Restrict)
  vehicleId String?
  zoneId String?
  serviceDate String?
  spaceUnits Int @default(0)
  detergentBuckets Int @default(0)
  scentBeadBuckets Int @default(0)
  lastError String?
  recoveryCheckedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  costs CheckoutCostAllocation[]
  events CheckoutProviderEvent[]
  @@unique([customerId, requestKey])
  @@index([state, updatedAt])
  @@index([subscriptionCycleId])
  @@index([vehicleId, serviceDate, state])
}

/// Holds FIFO quantities without altering receipt costs; immutable after consumption.
model CheckoutCostAllocation {
  id String @id @default(cuid())
  checkoutId String
  checkout CheckoutAttempt @relation(fields: [checkoutId], references: [id], onDelete: Restrict)
  costLayerId String
  costLayer InventoryCostLayer @relation(fields: [costLayerId], references: [id], onDelete: Restrict)
  quantity Int
  unitCostCents Int
  state String @default("HELD")
  @@unique([checkoutId, costLayerId])
  @@index([costLayerId, state])
}

/// Minimal signed provider evidence. Raw card/customer payloads are never stored.
model CheckoutProviderEvent {
  id String @id
  checkoutId String
  checkout CheckoutAttempt @relation(fields: [checkoutId], references: [id], onDelete: Restrict)
  type String
  evidence Json
  verifiedAt DateTime
  createdAt DateTime @default(now())
}

/// Append-only signed refund accounting. A compensation never removes the original refund.
model RefundAdjustment {
  taxEvidence RefundTaxEvidence?
  id String @id @default(cuid())
  requestId String
  request RefundRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  kind String
  cashCents Int
  netCents Int
  taxCents Int
  rewardCents Int
  currency String
  providerRefundId String?
  balanceTransactionId String?
  failureBalanceTransactionId String?
  taxEvidenceStatus String @default("UNVERIFIED")
  createdAt DateTime @default(now())
  @@unique([requestId, kind])
}

model SubscriptionEvent {
  id String @id @default(cuid())
  subscriptionId String
  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  requestKey String @unique
  requestHash String
  actorUserId String
  action String
  evidence Json
  createdAt DateTime @default(now())
  @@index([subscriptionId, createdAt])
}

model SubscriptionCycle {
  id String @id @default(cuid())
  subscriptionId String
  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  cycleNumber Int
  scheduledFor DateTime @db.Date
  state String @default("READY")
  snapshot Json
  paidCheckoutId String? @unique
  paidCheckout CheckoutAttempt? @relation("CyclePayment", fields: [paidCheckoutId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  attempts CheckoutAttempt[] @relation("CycleAttempts")
  @@unique([subscriptionId, cycleNumber])
  @@index([state, scheduledFor])
}

model RefundTaxEvidence {
 id String @id @default(cuid())
 adjustmentId String @unique
 adjustment RefundAdjustment @relation(fields: [adjustmentId], references: [id], onDelete: Restrict)
 providerAccountId String
 livemode Boolean
 reportRunId String
 fileId String
 reportHash String
 originalTaxTransactionId String
 refundTaxTransactionId String
 taxCents Int
 currency String
 createdAt DateTime @default(now())
 @@unique([providerAccountId, livemode, refundTaxTransactionId], map: "RefundTaxEvidence_provider_refund_key")
}

model CommerceGrant {
 id String @id
 userId String
 user User @relation(fields: [userId], references: [id], onDelete: Restrict)
 customerId String
 customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
 tokenHash String @unique
 requestHash String
 sessionVersion Int
 environment String
 label String
 scopes String[]
 consentVersion String
 expiresAt DateTime
 revokedAt DateTime?
 lastUsedAt DateTime?
 windowStartedAt DateTime?
 requestCount Int @default(0)
 createdAt DateTime @default(now())
 @@index([customerId, createdAt])
}

model SmsConsent {
  deliveries SmsDelivery[]
  id String @id @default(cuid())
  customerId String
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  environment String
  accountSid String
  sender String
  phone String
  timezone String
  consentVersion String
  codeHash String @unique
  state String @default("PENDING")
  expiresAt DateTime
  activatedAt DateTime?
  revokedAt DateTime?
  createdAt DateTime @default(now())
  @@index([customerId, environment, createdAt])
  @@index([environment, accountSid, phone, state])
}

model SmsInboundEvent {
  id String @id
  eventHash String
  kind String
  createdAt DateTime @default(now())
}

model SmsDelivery {
 events SmsDeliveryEvent[]
 id String @id @default(uuid())
 orderId String
 order Order @relation(fields:[orderId],references:[id],onDelete:Restrict)
 consentId String
 consent SmsConsent @relation(fields:[consentId],references:[id],onDelete:Restrict)
 environment String
 accountSid String
 sender String
 phone String
 kind String
 status String @default("PENDING")
 body String?
 providerSid String? @unique
 attempts Int @default(0)
 nextAttemptAt DateTime @default(now())
 submittedAt DateTime?
 checkedAt DateTime?
 issue String?
 expiresAt DateTime
 createdAt DateTime @default(now())
 @@unique([orderId,kind])
 @@index([environment,accountSid,status,nextAttemptAt])
}
model SmsDeliveryEvent {
 id String @id
 deliveryId String
 delivery SmsDelivery @relation(fields:[deliveryId],references:[id],onDelete:Restrict)
 providerSid String
 status String
 createdAt DateTime @default(now())
}

model QboCostExport {
  id String @id
  orderId String
  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  returnId String?
  stockReturn StockReturn? @relation(fields: [returnId], references: [id], onDelete: Restrict)
  parentSaleId String?
  parentSale QboCostExport? @relation("CostReturnSale", fields: [parentSaleId], references: [id], onDelete: Restrict)
  returns QboCostExport[] @relation("CostReturnSale")
  sourceKey String
  mode String
  realm String
  status String @default("DRAFT")
  docNumber String
  requestHash String
  source Json
  mapping Json
  payload Json
  externalId String?
  submittedAt DateTime?
  confirmedAt DateTime?
  recoveryCheckedAt DateTime?
  reconciliationIssue String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([mode, realm, docNumber])
  @@unique([mode, realm, externalId])
  @@index([sourceKey, status])
  @@index([mode, realm, status, recoveryCheckedAt])
}
